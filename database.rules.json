{
  "rules": {
    ".read": false,
    ".write": false,
    "userHouseholds": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.isString() && newData.val().length < 128"
      }
    },
    "households": {
      "$hid": {
        "members": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && (data.parent().exists() || $hid == auth.uid)",
            ".validate": "(newData.isString() && newData.val().length < 256) || (newData.child('email').isString() && newData.child('email').val().length < 256)"
          }
        },
        "state": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()"
        },
        "stateV1Backup": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()"
        },
        "meta": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          "schemaVersion": {
            ".validate": "newData.isNumber()"
          }
        },
        "settings": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          "hourlyRateCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "fuelRateCents": { ".validate": "newData.isNumber() && newData.val() >= 0" }
        },
        "week": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          "weekStart": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "bonusCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "carryoverCents": { ".validate": "newData.isNumber() && newData.val() >= 0" }
        },
        "cash": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          "counts": {
            "$bill": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        },
        "cashTransactions": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          "$id": {
            "amountCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "label": { ".validate": "newData.isString() && newData.val().length < 512" }
          }
        },
        "history": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          "$id": {
            "amountPaidCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "totalCents": { ".validate": "newData.isNumber()" }
          }
        },
        "archivedWeeks": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()"
        },
        "priorPayments": {
          ".read": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('households/' + $hid + '/members/' + auth.uid).exists()",
          "$id": {
            "amountCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "dateKey": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" }
          }
        }
      }
    }
  }
}
